# ── Хранилище лидов ──────────────────────────────────────────────
# supabase | console. Пусто = авто (supabase, если заданы ключи ниже; иначе console).
LEAD_STORE=console
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Meta (Pixel + Conversions API) ───────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_DATASET_ID=

# ── TikTok Pixel ─────────────────────────────────────────────────
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Каждая завершённая заявка → в Telegram ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=            # опц.: id темы форума (если нужен конкретный топик)

# ── Опционально: Slack-вебхук при тире A ─────────────────────────
NOTIFY_WEBHOOK_URL=
